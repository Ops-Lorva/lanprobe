[Unit]
Description=Sonde LanProbe (mesure et envoi au hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ⚠️ N'écoute sur aucun port : la sonde est cliente du hub. Le rattachement
# se fait à la main, une fois, avant d'activer le service :
#   sudo -u lanprobe lanprobe-server --config-dir /var/lib/lanprobe \
#        enroll --hub https://hub.exemple.fr --code A1B2-C3D4
ExecStart=/usr/bin/lanprobe-server --config-dir /var/lib/lanprobe run
Restart=on-failure
RestartSec=5

# Utilisateur dédié — créé par postinst. Les capabilities CAP_NET_RAW et
# CAP_NET_ADMIN sont appliquées au binaire via `setcap` dans le postinst
# pour permettre les ping ICMP raw et les changements d'IP sans être root.
User=lanprobe
Group=lanprobe
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

StateDirectory=lanprobe
StateDirectoryMode=0750
ReadWritePaths=/var/lib/lanprobe

# Hardening raisonnable — on garde l'accès réseau mais on lock le reste.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
